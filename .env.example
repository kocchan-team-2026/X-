# このファイルを .env にコピーして値を入れてください(scripts/setup.sh が対話で作ることもできます)。
# .env は .gitignore 済みです。トークンは絶対にコミット・共有しないでください。

# ---- 必須 ----
# Discord Bot のトークン(Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=
# Xdeck の API トークン
XDECK_TOKEN=

# ---- Discord のチャンネル ----
# アダルト用ボードが拾うチャンネルID(カンマ区切り)。空なら、エンタメ用以外の全チャンネル
CHANNEL_IDS=
# エンタメ用ボードが拾うチャンネルID(カンマ区切り)。空ならエンタメ用ボードは使いません
CHANNEL_IDS_ENT=

# ---- 任意(下は初期値。変えたいものだけ外して使う) ----
# XDECK_URL=http://127.0.0.1:39150/api/v1
# DISCORD_URL=                 # サイドバーの「Discordを開く」の飛び先(空なら、Bot が見ているサーバー/チャンネルを自動で開く)
# DATA_DIR=                    # データの保存先(初期値: このフォルダの data/)
# GALLERY_PORT=8765            # アダルト用ボードのポート
# GALLERY_PORT_ENT=8766        # エンタメ用ボードのポート
# IMP_TARGET=2500              # このインプ数に達したら Discord 通知 + 自動リプ
# FOLLOWUP=1                   # 0 にすると、インプ達成後の自動リプを止める
# LIKE_TARGET=40               # インプが未達でも、いいねがこの数に達したら自動リプする(0 で無効。投稿から48時間以内を15分おきに確認)
# FOLLOWUP_TEXT=続きです〜        # アダルト用: 1つ目のリプ本文(2つ目はアフィリエイトリンク)
# FOLLOWUP_TEXT_ENT=おすすめです〜  # エンタメ用: 1つ目のリプ本文(続けてアダルト用の最近の投稿URLを1件ずつ)
# RECOMMEND_N=3                # エンタメ用: おすすめとして貼る投稿数
